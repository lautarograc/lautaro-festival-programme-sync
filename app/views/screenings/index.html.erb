<div class="w-full max-w-5xl mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Festival Screenings</h1>
    <p class="text-gray-500">Browse what's on across the festival's venues.</p>
  </header>

  <%= turbo_frame_tag "screenings", data: { turbo_action: "advance" } do %>
    <%= render "filter_form", venues: @venues %>

    <div class="overflow-x-auto rounded-lg border border-gray-200">
      <div role="table" class="min-w-full divide-y divide-gray-200">
        <div role="row" class="grid grid-cols-4 bg-gray-50">
          <div role="columnheader" class="min-w-0 truncate px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
            <%= screenings_sort_link("Film", "film", current_sort: @sort, current_direction: @direction) %>
          </div>
          <div role="columnheader" class="min-w-0 truncate px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
            <%= screenings_sort_link("Venue", "venue", current_sort: @sort, current_direction: @direction) %>
          </div>
          <div role="columnheader" class="min-w-0 truncate px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
            <%= screenings_sort_link("Starts", "starts_at", current_sort: @sort, current_direction: @direction) %>
          </div>
          <div role="columnheader" class="min-w-0 truncate px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
            <%= screenings_sort_link("Status", "status", current_sort: @sort, current_direction: @direction) %>
          </div>
        </div>

        <div role="rowgroup" class="bg-white">
          <%= render "results", screenings: @screenings, page: @page, has_more: @has_more %>
        </div>
      </div>
    </div>
  <% end %>
</div>
