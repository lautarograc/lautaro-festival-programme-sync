<%= turbo_frame_tag "screenings_page_#{page}", class: "block" do %>
  <% screenings.each do |screening| %>
    <div role="row" class="grid grid-cols-4 border-b border-gray-100">
      <div role="cell" class="min-w-0 truncate px-4 py-3 text-sm font-medium text-gray-900"><%= screening.film.title %></div>
      <div role="cell" class="min-w-0 truncate px-4 py-3 text-sm text-gray-700"><%= screening.venue.name %></div>
      <div role="cell" class="min-w-0 truncate px-4 py-3 text-sm text-gray-700"><%= screening.starts_at.strftime("%a %d %b, %-l:%M%P") %></div>
      <div role="cell" class="min-w-0 truncate px-4 py-3 text-sm">
        <% if screening.cancelled? %>
          <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Cancelled</span>
        <% else %>
          <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Scheduled</span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if screenings.empty? && page == 1 %>
    <div role="row" class="border-b border-gray-100 px-4 py-8 text-center text-gray-400">No screenings match your filters.</div>
  <% end %>

  <% if has_more %>
    <%= turbo_frame_tag "screenings_page_#{page + 1}",
          src: screenings_path(request.query_parameters.merge("page" => page + 1)),
          loading: "lazy",
          class: "block" do %>
      <div role="row" class="border-b border-gray-100 px-4 py-6 text-center text-gray-400">Loading more…</div>
    <% end %>
  <% end %>
<% end %>
