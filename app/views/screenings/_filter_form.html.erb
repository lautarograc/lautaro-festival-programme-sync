<%= form_with url: screenings_path, method: :get,
      class: "flex flex-wrap items-end gap-3 mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200",
      data: { controller: "auto-submit" } do |f| %>
  <div class="flex flex-col">
    <%= f.label :date, "Date", class: "text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :date, value: params[:date], class: "rounded-md border-gray-300 shadow-sm",
          data: { action: "change->auto-submit#submit" } %>
  </div>

  <% selected_venue_ids = Array(params[:venue_ids]).reject(&:blank?)
     selected_venues = venues.select { |v| selected_venue_ids.include?(v.id.to_s) }
     venue_summary = if selected_venues.empty?
                        "All venues"
                      elsif selected_venues.one?
                        selected_venues.first.name
                      else
                        "#{selected_venues.size} selected"
                      end %>
  <div id="venue-dropdown" class="relative flex flex-col" data-controller="dropdown">
    <label class="text-sm font-medium text-gray-700 mb-1" for="venue-dropdown-button">Venue</label>
    <button type="button" id="venue-dropdown-button"
          class="w-48 flex items-center justify-between gap-2 rounded-md border border-gray-300 shadow-sm bg-white px-3 py-2 text-sm text-gray-900"
          data-action="click->dropdown#toggle" data-dropdown-target="button">
      <span data-dropdown-target="summary" data-placeholder="All venues"><%= venue_summary %></span>
      <svg class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </button>

    <div class="hidden absolute z-10 mt-1 top-full w-48 max-h-56 overflow-y-auto rounded-md border border-gray-300 bg-white shadow-lg"
          data-dropdown-target="panel">
      <% venues.each do |venue| %>
        <label class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 cursor-pointer hover:bg-gray-50">
          <%= check_box_tag "venue_ids[]", venue.id, selected_venue_ids.include?(venue.id.to_s),
                id: "venue_ids_#{venue.id}",
                class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500",
                data: { label: venue.name, action: "change->dropdown#submit" } %>
          <%= venue.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col grow">
    <%= f.label :q, "Search titles", class: "text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :q, value: params[:q], placeholder: "e.g. Autumn", class: "rounded-md border-gray-300 shadow-sm w-full",
          data: { action: "input->auto-submit#debouncedSubmit" } %>
  </div>

  <%= f.submit "Filter", class: "rounded-md bg-gray-900 px-4 py-2 text-white font-medium hover:bg-gray-700 cursor-pointer" %>
<% end %>
